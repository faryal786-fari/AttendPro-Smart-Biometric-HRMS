# Copy to .env, fill your REAL Supabase values. Never upload .env or keys.
SUPABASE_ENABLED=1
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_SECRET
APP_TIMEZONE=Asia/Karachi
# For HTTPS production set 1 and serve behind TLS/reverse-proxy.
ATTENDPRO_HTTPS=0
# MDB path is configured in the application's Device Status page.
# MDB must remain READ-ONLY to this service.

# Production only, set to the public HTTPS origin behind your reverse proxy.
# ATTENDPRO_PUBLIC_ORIGIN=https://hr.example.com

# Redis cache, one-hour scheduler, and discrepancy exception rules.
# Local Ubuntu: redis://127.0.0.1:6379/0
# Production: use a private managed Redis/Key Value URL; never expose it publicly.
REDIS_CACHE_ENABLED=1
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_API_CACHE_TTL_SECONDS=3600  # Read-through response cache TTL
REDIS_KEY_PREFIX=attendpro:v1
# Automatic MDB read + Redis refresh. One-hour minimum is enforced in code.
ATTENDPRO_HOURLY_SCHEDULER_ENABLED=1
ATTENDPRO_MDB_SCHEDULER_INTERVAL_SECONDS=3600
REDIS_SCHEDULER_LOCK_TTL_SECONDS=4200
# Only explicitly confirmed Not Configured employees with an MDB check-in
# are automatically marked On Leave in the effective Supabase correction layer.
ATTENDPRO_AUTO_LEAVE_UNCONFIGURED_BIOMETRIC=1
