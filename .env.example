# AttendPro public site configuration (safe placeholders only)
ATTENDPRO_PUBLIC_ORIGIN=https://ptclahore.co
ATTENDPRO_ALLOWED_ORIGINS=https://ptclahore.co,https://www.ptclahore.co,https://attendpro-smart-biometric-hrms-static-op69zq26j-faryal3.vercel.app

# Supabase cloud mode (fill these on the server; never commit real keys)
SUPABASE_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional local server settings
APP_TIMEZONE=Asia/Karachi
ATTENDANCE_DATA_DIR=./data
ATTENDPRO_MDB_PATH=./data/source/att20002.mdb
